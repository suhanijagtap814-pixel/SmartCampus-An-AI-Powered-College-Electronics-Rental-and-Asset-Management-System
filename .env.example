# ==============================================================================
# Smart Campus Electronics Rental - Environment Configuration
# ==============================================================================

# Application Security
SECRET_KEY=campus-smart-rental-secret-key-2026-secure

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# DATABASE_URL takes priority over the discrete POSTGRES_* parameters below.
# SSL (sslmode=require) is added automatically for any non-localhost host.
# Copy this file to `.env` and fill in your real values there (never here).
#
# --- Supabase (recommended). Dashboard -> Project Settings -> Database -----
# (A) Session pooler (IPv4), best for a long-running Flask app:
# DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# (B) Direct connection (needs IPv6):
# DATABASE_URL=postgresql://postgres:<DB-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres

# Supabase project API credentials (NOT used by SQLAlchemy; optional, for any
# future REST/Auth client). Leave blank or fill in your own .env, not here.
SUPABASE_URL=your-supabase-url-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here
SUPABASE_JWKS_URL=your-jwks-url-here

# --- Local PostgreSQL fallback (used only when DATABASE_URL above is unset) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campus_rental


# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Live or Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=t7J9kF2mN8pQ4sV6

# ------------------------------------------------------------------------------
# 3. Optional: Google Gemini AI API Key (for real LLM chatbot expansion)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
